  {"start": 24.109, "end": 26.94, "original_start": 30.154, "original_end": 32.985, "confidence": 1.0, "text": "Fix these three things and your watch time goes up."},
  {"start": 27.27, "end": 28.417, "original_start": 33.315, "original_end": 34.462, "confidence": 1.0, "text": "Follow for part two."}
