  {"start": 16.545, "end": 18.94, "original_start": 21.89, "original_end": 24.285, "confidence": 1.0, "text": "And mistake number three: no captions."},
  {"start": 19.32, "end": 22.011, "original_start": 24.665, "original_end": 27.356, "confidence": 1.0, "text": "Most people watch with the sound off, so if there"},
