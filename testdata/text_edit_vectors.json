{
  "comment": "Transcript text edits on words (backend/doc.py apply_text_edit; web/src/features/editor/state/textEdit.ts applyTextEdit). words: the edited span (SOURCE seconds); text: its new text; taken: ids used elsewhere in the doc; expected: the span's words afterwards (times compared to 1e-6).",
  "vectors": [
    {
      "name": "unchanged text keeps every word",
      "words": [
        {"id": "w1", "text": "we", "start": 1.0, "end": 1.2},
        {"id": "w2", "text": "go", "start": 1.25, "end": 1.5}
      ],
      "text": "we go",
      "expected": [
        {"id": "w1", "text": "we", "start": 1.0, "end": 1.2},
        {"id": "w2", "text": "go", "start": 1.25, "end": 1.5}
      ]
    },
    {
      "name": "one word replaced by one keeps its id and timing",
      "words": [
        {"id": "w1", "text": "we", "start": 1.0, "end": 1.2},
        {"id": "w2", "text": "gonna", "start": 1.2, "end": 1.6, "conf": 0.62},
        {"id": "w3", "text": "win", "start": 1.7, "end": 2.0}
      ],
      "text": "we going win",
      "expected": [
        {"id": "w1", "text": "we", "start": 1.0, "end": 1.2},
        {"id": "w2", "text": "going", "start": 1.2, "end": 1.6, "conf": 0.62},
        {"id": "w3", "text": "win", "start": 1.7, "end": 2.0}
      ]
    },
    {
      "name": "one word split into two shares its time by characters",
      "words": [
        {"id": "w1", "text": "we", "start": 1.0, "end": 1.2},
        {"id": "w2", "text": "gonna", "start": 1.2, "end": 1.6},
        {"id": "w3", "text": "win", "start": 1.7, "end": 2.0}
      ],
      "text": "we going to win",
      "expected": [
        {"id": "w1", "text": "we", "start": 1.0, "end": 1.2},
        {"id": "w2", "text": "going", "start": 1.2, "end": 1.486},
        {"id": "w2.1", "text": "to", "start": 1.486, "end": 1.6},
        {"id": "w3", "text": "win", "start": 1.7, "end": 2.0}
      ]
    },
    {
      "name": "two words merged into one take the run's time and the first id",
      "words": [
        {"id": "w1", "text": "every", "start": 0.5, "end": 0.8},
        {"id": "w2", "text": "one", "start": 0.85, "end": 1.1},
        {"id": "w3", "text": "here", "start": 1.2, "end": 1.5}
      ],
      "text": "everyone here",
      "expected": [
        {"id": "w1", "text": "everyone", "start": 0.5, "end": 1.1},
        {"id": "w3", "text": "here", "start": 1.2, "end": 1.5}
      ]
    },
    {
      "name": "a run of two replaced by one in the middle",
      "words": [
        {"id": "w1", "text": "we", "start": 0.0, "end": 0.2},
        {"id": "w2", "text": "are", "start": 0.25, "end": 0.4},
        {"id": "w3", "text": "gonna", "start": 0.4, "end": 0.7},
        {"id": "w4", "text": "win", "start": 0.8, "end": 1.0}
      ],
      "text": "we will win",
      "expected": [
        {"id": "w1", "text": "we", "start": 0.0, "end": 0.2},
        {"id": "w2", "text": "will", "start": 0.25, "end": 0.7},
        {"id": "w4", "text": "win", "start": 0.8, "end": 1.0}
      ]
    },
    {
      "name": "a deleted word merges its time into the word before",
      "words": [
        {"id": "w1", "text": "the", "start": 2.0, "end": 2.1},
        {"id": "w2", "text": "the", "start": 2.2, "end": 2.3},
        {"id": "w3", "text": "cat", "start": 2.35, "end": 2.7}
      ],
      "text": "the cat",
      "expected": [
        {"id": "w1", "text": "the", "start": 2.0, "end": 2.3},
        {"id": "w3", "text": "cat", "start": 2.35, "end": 2.7}
      ]
    },
    {
      "name": "a deleted first word hands its time to the next word",
      "words": [
        {"id": "w1", "text": "so", "start": 0.3, "end": 0.5, "breakBefore": true},
        {"id": "w2", "text": "we", "start": 0.6, "end": 0.7},
        {"id": "w3", "text": "go", "start": 0.75, "end": 1.0}
      ],
      "text": "we go",
      "expected": [
        {"id": "w2", "text": "we", "start": 0.3, "end": 0.7, "breakBefore": true},
        {"id": "w3", "text": "go", "start": 0.75, "end": 1.0}
      ]
    },
    {
      "name": "an inserted word splits the time of the word before it",
      "words": [
        {"id": "w1", "text": "hello", "start": 1.0, "end": 1.5},
        {"id": "w2", "text": "world", "start": 1.6, "end": 2.0}
      ],
      "text": "hello big world",
      "expected": [
        {"id": "w1", "text": "hello", "start": 1.0, "end": 1.313},
        {"id": "w1.1", "text": "big", "start": 1.313, "end": 1.5},
        {"id": "w2", "text": "world", "start": 1.6, "end": 2.0}
      ]
    },
    {
      "name": "a word inserted at the start splits the first word's time",
      "words": [
        {"id": "w1", "text": "world", "start": 3.0, "end": 3.5}
      ],
      "text": "hello world",
      "expected": [
        {"id": "w1.1", "text": "hello", "start": 3.0, "end": 3.25},
        {"id": "w1", "text": "world", "start": 3.25, "end": 3.5}
      ]
    },
    {
      "name": "punctuation and case changes are 1:1 replacements",
      "words": [
        {"id": "w1", "text": "its", "start": 0.0, "end": 0.2},
        {"id": "w2", "text": "a", "start": 0.2, "end": 0.3},
        {"id": "w3", "text": "test", "start": 0.3, "end": 0.6}
      ],
      "text": "It's a test.",
      "expected": [
        {"id": "w1", "text": "It's", "start": 0.0, "end": 0.2},
        {"id": "w2", "text": "a", "start": 0.2, "end": 0.3},
        {"id": "w3", "text": "test.", "start": 0.3, "end": 0.6}
      ]
    },
    {
      "name": "a changed run of hidden words stays hidden; breakBefore stays on the first",
      "words": [
        {"id": "w1", "text": "ok", "start": 0.0, "end": 0.3},
        {"id": "w2", "text": "you", "start": 0.4, "end": 0.5, "hidden": true, "breakBefore": true},
        {"id": "w3", "text": "know", "start": 0.5, "end": 0.7, "hidden": true}
      ],
      "text": "ok y'know",
      "expected": [
        {"id": "w1", "text": "ok", "start": 0.0, "end": 0.3},
        {"id": "w2", "text": "y'know", "start": 0.4, "end": 0.7, "hidden": true, "breakBefore": true}
      ]
    },
    {
      "name": "new ids skip ids already in the doc",
      "words": [
        {"id": "w7", "text": "gonna", "start": 5.0, "end": 5.4}
      ],
      "text": "going to",
      "taken": [
        "w7.1"
      ],
      "expected": [
        {"id": "w7", "text": "going", "start": 5.0, "end": 5.286},
        {"id": "w7.2", "text": "to", "start": 5.286, "end": 5.4}
      ]
    },
    {
      "name": "everything deleted: no words",
      "words": [
        {"id": "w1", "text": "um", "start": 0.0, "end": 0.2},
        {"id": "w2", "text": "yeah", "start": 0.3, "end": 0.5}
      ],
      "text": "  ",
      "expected": []
    },
    {
      "name": "CJK tokens merged",
      "words": [
        {"id": "w1", "text": "今日", "start": 0.0, "end": 0.3},
        {"id": "w2", "text": "は", "start": 0.3, "end": 0.4},
        {"id": "w3", "text": "晴れ", "start": 0.5, "end": 0.9}
      ],
      "text": "今日は 晴れ",
      "expected": [
        {"id": "w1", "text": "今日は", "start": 0.0, "end": 0.4},
        {"id": "w3", "text": "晴れ", "start": 0.5, "end": 0.9}
      ]
    },
    {
      "name": "whitespace of any kind separates tokens",
      "words": [
        {"id": "w1", "text": "a", "start": 0.0, "end": 0.1},
        {"id": "w2", "text": "b", "start": 0.1, "end": 0.2}
      ],
      "text": " a\tb　c ",
      "expected": [
        {"id": "w1", "text": "a", "start": 0.0, "end": 0.1},
        {"id": "w2", "text": "b", "start": 0.1, "end": 0.15},
        {"id": "w2.1", "text": "c", "start": 0.15, "end": 0.2}
      ]
    }
  ]
}
